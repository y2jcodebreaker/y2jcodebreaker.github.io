---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuthorList from '../components/AuthorList.astro';
import { loadCv, loadProfile } from '../lib/data';
import { isRendered } from '../lib/papers';

const profile = loadProfile();
const cv = loadCv();

// Publications come from the papers collection — the same source the homepage
// uses — so this page cannot drift out of step with it.
const entries = (await getCollection('papers'))
  .filter((e) => isRendered(e.data))
  // Same order as the PDF: papers before the patent; within a year, fewer
  // authors first, so sole-authored work leads.
  .sort((a, b) =>
    (Number(a.data.status === 'patent') - Number(b.data.status === 'patent')) ||
    (b.data.year - a.data.year) ||
    (a.data.authors.length - b.data.authors.length));

// Unfinished work is listed, and listed apart. A project with no manuscript
// under a heading that reads "Publications" would be a claim this CV cannot
// support, which is the one thing a CV may not do.
const papers = entries.filter((e) => e.data.status !== 'in-progress');
const inProgress = entries.filter((e) => e.data.status === 'in-progress');

const statusLabel = (p: (typeof entries)[number]['data']) =>
  p.status === 'published' ? p.venue : p.status === 'patent' ? 'Patent filed' : 'Preprint';

const sections = [
  { title: 'Education', entries: cv.education },
  { title: 'Experience', entries: cv.experience },
];
---
<Base title={`CV — ${profile.name}`} description={`Curriculum vitae for ${profile.name}`}>
  <p class="back"><a href="/">← {profile.name}</a></p>

  <h1>Curriculum Vitae</h1>
  <p class="muted download"><a href="/cv.pdf">Download PDF</a></p>

  <section>
    <h2>Publications</h2>
    {papers.map((entry) => (
      <div class="entry">
        <h3 class="entry-head">
          {entry.data.title}
          <span class="dates muted">{statusLabel(entry.data)}</span>
        </h3>
        <AuthorList paper={entry.data} />
        <p class="sub">{entry.data.tldr}</p>
      </div>
    ))}
  </section>

  {inProgress.length > 0 && (
    <section>
      <h2>Work in progress</h2>
      {inProgress.map((entry) => (
        <div class="entry">
          <h3 class="entry-head">
            {entry.data.title}
            <span class="dates muted">{entry.data.year}</span>
          </h3>
          <AuthorList paper={entry.data} />
          <p class="sub">{entry.data.tldr}</p>
        </div>
      ))}
    </section>
  )}

  {sections.map((section) => section.entries.length > 0 && (
    <section>
      <h2>{section.title}</h2>
      {section.entries.map((e) => (
        <div class="entry">
          <h3 class="entry-head">
            {e.heading}
            {e.dates ? <span class="dates muted">{e.dates}</span> : null}
          </h3>
          {e.subheading ? <p class="sub muted">{e.subheading}{e.location ? `, ${e.location}` : ''}</p> : null}
          {e.bullets.length > 0 && (
            <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
          )}
        </div>
      ))}
    </section>
  ))}

  {cv.skills.length > 0 && (
    <section>
      <h2>Skills</h2>
      {cv.skills.map((group) => (
        <p class="skill"><span class="skill-label">{group.label}:</span> {group.items.join(', ')}</p>
      ))}
    </section>
  )}
</Base>

<style>
  .back, .download { font-size: var(--size-sm); }
  .download { margin-bottom: var(--space-3); }
  section { margin-bottom: var(--space-4); }
  section h2 { margin-bottom: var(--space-2); }
  .entry { margin-bottom: var(--space-3); }
  .entry-head { display: flex; justify-content: space-between; gap: var(--space-2); align-items: baseline; }
  .dates { font-size: var(--size-sm); white-space: nowrap; font-weight: 400; }
  .sub { margin: 0 0 var(--space-1); font-size: var(--size-sm); }
  ul { margin: var(--space-1) 0; padding-left: 1.2em; }
  .skill { margin-bottom: var(--space-1); }
  .skill-label { color: var(--ink-muted); }
</style>
